{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "plugins": [{ "name": "workflow" }]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.ts"]
}
